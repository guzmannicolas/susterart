# URL base de tu Directus (HTTPS, sin barra final). Es pública: se usa para mostrar imágenes.
PUBLIC_DIRECTUS_URL=https://directus.tu-dominio.com

# Token estático de SOLO LECTURA (usuario/rol dedicado, nunca admin).
# Solo se usa en el servidor durante el build; no lleva prefijo PUBLIC_ a propósito.
DIRECTUS_TOKEN=
