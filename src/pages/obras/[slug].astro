---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectusImage from '../../components/DirectusImage.astro';
import { getContacto, getObras } from '../../lib/content';
import { assetUrl } from '../../lib/directus';
import { formatPrice } from '../../lib/format';

export const getStaticPaths = (async () => {
  const [obras, contacto] = await Promise.all([getObras(), getContacto()]);
  return obras.map((obra, i) => ({
    params: { slug: obra.slug },
    props: { obra, contacto, prev: obras[i - 1] ?? null, next: obras[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { obra, contacto, prev, next } = Astro.props;
const estados = { disponible: 'Disponible', consultar: 'Precio a consultar', agotado: 'Agotada' } as const;
const precio = obra.estado === 'disponible' ? formatPrice(obra.precio, 'EUR') : null;
const datos = [
  ['Año', obra.anio],
  ['Técnica', obra.tecnica],
  ['Medidas', obra.medidas],
  ['Estado', estados[obra.estado]],
  ['Precio', precio],
].filter((d): d is [string, string | number] => d[1] != null && d[1] !== '');
const asunto = encodeURIComponent(`Consulta por la obra "${obra.titulo}"`);
---

<BaseLayout
  title={obra.titulo}
  description={obra.descripcion ?? `${obra.titulo}, obra de Belen Sustersic.`}
  image={obra.imagen ? assetUrl(obra.imagen, { width: 1200 }) : undefined}
>
  <p><a href="/obras">← Todas las obras</a></p>
  <div class="layout">
    <DirectusImage id={obra.imagen} alt={`${obra.titulo}${obra.tecnica ? `, ${obra.tecnica}` : ''}`} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" class="obra-img" />
    <div>
      <h1>{obra.titulo}</h1>
      <dl>
        {datos.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
      {obra.descripcion && <p class="prose">{obra.descripcion}</p>}
      {
        obra.estado !== 'agotado' && (contacto?.email || contacto?.whatsapp) && (
          <p class="actions">
            {contacto.email && (
              <a class="button" href={`mailto:${contacto.email}?subject=${asunto}`}>Adquirir</a>
            )}
            {contacto.whatsapp && (
              <a class="button" href={contacto.whatsapp} rel="noopener noreferrer" target="_blank">
                WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
              </a>
            )}
          </p>
        )
      }
    </div>
  </div>
  <nav class="pager" aria-label="Obras">
    {prev ? <a href={`/obras/${prev.slug}`} rel="prev">← {prev.titulo}</a> : <span />}
    {next ? <a href={`/obras/${next.slug}`} rel="next">{next.titulo} →</a> : <span />}
  </nav>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  :global(.obra-img) {
    width: 100%;
    background: var(--soft);
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.5rem;
    margin: 0 0 1.5rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
</style>
