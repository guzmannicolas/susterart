---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContacto } from '../lib/content';

const c = await getContacto();
const canales = [
  { label: 'Email', text: c?.email, href: c?.email ? `mailto:${c.email}` : null },
  { label: 'WhatsApp', text: 'Escribir por WhatsApp', href: c?.whatsapp },
  { label: 'Instagram', text: '@suster.art', href: c?.instagram },
  { label: 'YouTube', text: 'Canal de YouTube', href: c?.youtube },
].filter((x): x is { label: string; text: string; href: string } => Boolean(x.text && x.href));
---

<BaseLayout title="Contacto" description="Contacto con Belen Sustersic.">
  <h1 class="page-title">Contacto</h1>
  {
    canales.length > 0 ? (
      <dl>
        {canales.map((x) => (
          <>
            <dt>{x.label}</dt>
            <dd>
              <a href={x.href} rel={x.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={x.href.startsWith('http') ? '_blank' : undefined}>
                {x.text}
                {x.href.startsWith('http') && <span class="visually-hidden"> (se abre en una pestaña nueva)</span>}
              </a>
            </dd>
          </>
        ))}
      </dl>
    ) : (
      <p class="empty">Próximamente.</p>
    )
  }
</BaseLayout>

<style>
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 2.5rem;
    font-size: 1.2rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
</style>
