---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { getCvItems } from '../../lib/content';
import type { CvTipo } from '../../lib/types';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const { lang } = Astro.props;
const t = ui[lang];
const items = await getCvItems(lang);
const tipos: CvTipo[] = ['formacion', 'exposicion_individual', 'exposicion_colectiva', 'premio', 'residencia', 'otro'];
---

<BaseLayout lang={lang} title={t.cv.title} description={t.cv.description}>
  <h1 class="page-title">{t.cv.title}</h1>
  {
    items.length > 0 ? (
      tipos.map((tipo) => {
        const lista = items.filter((i) => i.tipo === tipo);
        return (
          lista.length > 0 && (
            <section>
              <h2>{t.cv.sections[tipo]}</h2>
              <ul>
                {lista.map((i) => (
                  <li>
                    <span class="anio">{i.anio ?? ''}</span>
                    <div>
                      <strong>{i.titulo}</strong>
                      {i.lugar && <span class="muted">, {i.lugar}</span>}
                      {i.descripcion && <p class="muted">{i.descripcion}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        );
      })
    ) : (
      <p class="empty">{t.comingSoon}</p>
    )
  }
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
    max-width: var(--measure);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  li p {
    margin: 0.25rem 0 0;
  }
  .anio {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
</style>
