---
// Raíz: elige idioma según el navegador (por defecto español).
import { localeNames, locales } from '../i18n/config';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Belen Sustersic</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/es" />
    <noscript><meta http-equiv="refresh" content="0;url=/es" /></noscript>
    <style>
      body { font-family: system-ui, sans-serif; margin: 3rem 1.5rem; line-height: 1.6; }
      ul { list-style: none; padding: 0; }
      a { font-size: 1.25rem; }
    </style>
  </head>
  <body>
    <ul>
      {locales.map((l) => <li><a href={`/${l}`} lang={l} hreflang={l}>{localeNames[l]}</a></li>)}
    </ul>
    <script is:inline>
      var l = (navigator.language || 'es').toLowerCase();
      var target = l.indexOf('gsw') === 0 || l === 'de-ch' ? '/gsw' : l.indexOf('en') === 0 ? '/en' : '/es';
      location.replace(target);
    </script>
  </body>
</html>
