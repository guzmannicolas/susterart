---
import { imageSources } from '../lib/directus';

interface Props {
  id: string | null;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { id, alt, sizes = '100vw', loading = 'lazy', class: className } = Astro.props;
const sources = id ? imageSources(id) : null;
---

{
  sources ? (
    <img src={sources.src} srcset={sources.srcset} sizes={sizes} alt={alt} loading={loading} decoding="async" class={className} />
  ) : (
    <div class:list={['placeholder', className]} role="img" aria-label={`${alt} (imagen pendiente)`}>
      Imagen pendiente
    </div>
  )
}
