---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<!-- youtube-nocookie: no instala cookies hasta que la persona reproduce el video. -->
<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    loading="lazy"
    allow="encrypted-media; picture-in-picture; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    aspect-ratio: 16 / 9;
    background: var(--soft);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
