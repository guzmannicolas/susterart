---
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { getContacto } from '../lib/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const contacto = await getContacto();
const autoria = contacto?.nombre_autoria;
const redes = [
  { label: t.contact.instagram, href: contacto?.instagram },
  { label: t.contact.youtube, href: contacto?.youtube },
].filter((r): r is { label: string; href: string } => Boolean(r.href));
---

<footer>
  <div class="inner">
    {autoria && <p>{t.footer.rights(autoria)}</p>}
    {
      redes.length > 0 && (
        <ul>
          {redes.map((r) => (
            <li>
              <a href={r.href} rel="noopener noreferrer" target="_blank">
                {r.label}
                <span class="visually-hidden"> {t.external}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .inner {
    max-width: var(--max);
    padding-inline: var(--gutter);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 3rem;
  }
  p {
    margin: 0;
    max-width: 36rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }
</style>
