---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, htmlLang, locales, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { switchLocale } from '../i18n/url';
import { getAjustes } from '../lib/content';
import { demoEnabled } from '../lib/demo';
import { assetUrl } from '../lib/directus';

interface Props {
  lang: Locale;
  title?: string | undefined;
  description?: string | null | undefined;
  /** URL absoluta de la imagen para compartir; si falta se usa la de Ajustes. */
  image?: string | undefined;
}

const SITE_NAME = 'Belen Sustersic';
const { lang, title, description, image } = Astro.props;
const ajustes = await getAjustes(lang);

const metaDescription = description || ajustes?.descripcion || ui[lang].siteDescription;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const ogImage = image ?? (ajustes?.imagen_compartir ? assetUrl(ajustes.imagen_compartir, { width: 1200 }) : undefined);
const favicon = ajustes?.favicon ? assetUrl(ajustes.favicon, { width: 64 }) : '/favicon.svg';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = locales.map((l) => ({ l, href: new URL(switchLocale(Astro.url.pathname, l), Astro.site) }));
const ogLocale = htmlLang[lang].replace('-', '_');
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.l]} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.l === defaultLocale)?.href} />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="color-scheme" content="light dark" />
    {demoEnabled && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {demoEnabled && <p class="demo-banner" role="note">Vista previa de diseño: contenido e imágenes de ejemplo, no es el sitio final.</p>}
    <a class="skip-link" href="#contenido">{ui[lang].skip}</a>
    <Header lang={lang} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
